generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  cliente_id     Int       @id @unique @default(autoincrement())
  nombreCompleto String
  correo         String    @unique
  contrasena     String
  auth_uid       String?   @unique
  rol            Rol       @default(Regular)
  pushToken      String?
  metricas       Metrica[]
}

model Pais {
  pais_id    Int       @id @default(autoincrement())
  nombre     String    @unique
  codigo     String?   @unique
  activo     Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  ciudades   Ciudad[]
  empresas   Empresa[]
}

model Ciudad {
  ciudad_id  Int       @id @default(autoincrement())
  nombre     String
  pais_id    Int
  activo     Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  pais       Pais      @relation(fields: [pais_id], references: [pais_id])
  empresas   Empresa[]

  @@unique([nombre, pais_id])
  @@index([pais_id])
}

model Categoria {
  categoria_id Int       @id @default(autoincrement())
  nombre       String    @unique
  activo       Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  empresas     Empresa[]
}

model Empresa {
  empresa_id       Int            @id @unique @default(autoincrement())
  nombreCompleto   String
  correo           String         @unique
  contrasena       String
  auth_uid         String         @unique
  pushToken        String?
  categoria        String?
  ciudad           String?
  descripcion      String?
  descuento        String?
  fotoDescripcion1 String?
  fotoDescripcion2 String?
  fotoDescripcion3 String?
  fotoPerfil       String?
  pais             String?
  ubicacionMaps    String?
  whatsapp         String?
  lat              Float?
  lng              Float?
  activo           Boolean        @default(true)
  categoria_id     Int?
  ciudad_id        Int?
  created_at       DateTime       @default(now())
  destacada        Boolean        @default(false)
  pais_id          Int?
  popular          Boolean        @default(false)
  updated_at       DateTime?
  categoria_rel    Categoria?     @relation(fields: [categoria_id], references: [categoria_id])
  ciudad_rel       Ciudad?        @relation(fields: [ciudad_id], references: [ciudad_id])
  pais_rel         Pais?          @relation(fields: [pais_id], references: [pais_id])
  metricas         Metrica[]
  notificaciones   Notificacion[]
  productos        Producto[]
}

model Producto {
  producto_id Int     @id @default(autoincrement())
  nombre      String
  precio      Float
  imagenUrl   String
  descripcion String?
  empresa_id  Int
  empresa     Empresa @relation(fields: [empresa_id], references: [empresa_id])
}

model Metrica {
  metrica_id Int     @id @default(autoincrement())
  cliente_id Int
  empresa_id Int
  vecesScan  Int
  puntos     Int?
  cliente    Cliente @relation(fields: [cliente_id], references: [cliente_id])
  empresa    Empresa @relation(fields: [empresa_id], references: [empresa_id])

  @@unique([cliente_id, empresa_id])
}

model Notificacion {
  notificacion_id  Int       @id @default(autoincrement())
  titulo           String
  mensaje          String
  tipo             String    @default("general")
  fecha_envio      DateTime  @default(now())
  fecha_programada DateTime?
  enviada          Boolean   @default(false)
  filtros          Json?
  empresa_id       Int?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  empresa          Empresa?  @relation(fields: [empresa_id], references: [empresa_id])

  @@index([empresa_id])
  @@index([enviada])
  @@index([fecha_programada])
}

enum Rol {
  Admin
  Regular
}
